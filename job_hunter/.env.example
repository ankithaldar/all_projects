# Job Hunter app environment (APP_* only).
#
# LLM provider keys live in the gateway template — copy it to the gateway
# .env (setup.sh does this for you):
#   cp src/job_hunter/llm_gateway/.env.example src/job_hunter/llm_gateway/.env
# See src/job_hunter/llm_gateway/.env.example for the 9-provider key template.
#
# These APP_* variables must be exported (or sourced) in your shell for
# AppSettings to pick them up; they are not loaded from this file directly.

APP_HOST=127.0.0.1
APP_PORT=8088
APP_LOG_LEVEL=INFO
APP_DATA_DIR=./data
SALARY_HARD_FLOOR_LPA=45
