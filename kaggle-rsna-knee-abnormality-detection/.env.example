# Secrets loaded by knee.helpers.env (priority: os.environ -> .env -> Kaggle Secrets)
# Copy to .env and fill locally; on Kaggle add the same keys via Add-ons > Secrets.

# GitHub token for cloning PRIVATE pipeline repos inside kernels
GITHUB_TOKEN=

# Kaggle API -- REQUIRED for publish_dataset.py (artifact dataset pushes)
KAGGLE_USERNAME=
KAGGLE_KEY=

# OpenRouter API -- only for the 'weak-labels-llm' stage (LLM report labeling)
OPENROUTER_API_KEY=

# Discord training-updates webhook (channel integrations -> webhooks)
DISCORD_WEBHOOK_URL=

# Experiment tracking (optional; loggers self-disable when empty)
WANDB_API_KEY=
WANDB_PROJECT=rsna-knee          # W&B entity/project for deterministic per-fold runs
WANDB_MODE=online                # 'offline' enables the logger without an api_key
NEPTUNE_API_TOKEN=
NEPTUNE_PROJECT=
