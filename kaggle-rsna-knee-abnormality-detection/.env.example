# Copy to `.env` (never committed) and fill in the values you use.
# On Kaggle notebooks the same names can be registered under
# Add-ons > Secrets; knee.helpers.secrets checks env -> .env -> secrets.

# Discord webhook for experiment notifications.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY

# Weights & Biases.
WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WANDB_ENTITY=my-team            # optional override
# WANDB_MODE=offline              # force offline even with a key

# Kaggle API (local pushes/pulls; notebooks prefer User Secrets).
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
