# Experiment tracking (wandb). Set WANDB_MODE=offline to run without an
# account; WANDB_DISABLED=true turns the tracker off entirely.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=birdcall
WANDB_MODE=online

# The Discord webhook the epoch and validation summaries are posted to.
# Leave it empty and the run simply posts nothing.
DISCORD_WEBHOOK_URL=
